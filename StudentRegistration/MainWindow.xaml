<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentRegistration"
        mc:Ignorable="d"
        Title="Student Registration" Height="500" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Student Registration" FontSize="26" FontWeight="Bold"/>
            <Button Content="Refresh" Width="100" Margin="30,0,0,0" Click="RefreshButton_Click"/>
            <TextBlock x:Name="TotalStudentsTextBlock" Text="Total Mahasiswa: 0" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid x:Name="StudentDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="60"/>
                <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="100"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramName}" Width="180"/>
                <DataGridTextColumn Header="Tanggal Lahir" Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="No. Telepon" Binding="{Binding PhoneNumber}" Width="140"/>
                <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="250"/>
                <DataGridTextColumn Header="Dibuat" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
